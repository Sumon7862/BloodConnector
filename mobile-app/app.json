{
  "expo": {
    "name": "BloodConnector",
    "slug": "bloodconnector",
    "scheme": "bloodconnector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#07101C"
    },
    "androidStatusBar": {
      "backgroundColor": "#0B2447",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloodconnector.app"
    },
    "android": {
      "package": "com.bloodconnector.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B2447",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07101C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BloodConnector uses photos to update your donor profile picture."
        }
      ]
    ]
  }
}
